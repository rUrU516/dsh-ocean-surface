{
  "name": "@local/dsh-cursor-ripples",
  "version": "0.8.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rUrU516/dsh-ocean-surface.git"
  },
  "homepage": "https://github.com/rUrU516/dsh-ocean-surface#readme",
  "description": "Background Tapes: a quiet interactive background deck with a cassette drawer, local auditioning and four built-in effects.",
  "scripts": {
    "build": "node build.js",
    "test": "node --test *.test.js"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client-entry.js",
    "water-field.js",
    "water-field.test.js",
    "ocean-renderer.js",
    "build.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "appearance.js",
    "appearance-model.js",
    "appearance.test.js",
    "ocean-preview.js",
    "settings-panel.js",
    "buoy-icons.js",
    "cassette-catalog.js",
    "cassette-operations.js",
    "cassette-catalog.test.js",
    "effect-runtime.js",
    "effect-runtime.test.js",
    "effect-surface.js",
    "deck-panel.js",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
